<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Trimming / native AOT: enables the IL analyzers and marks the package as AOT-compatible.
         The IL warnings are errors so a new unannotated reflection call cannot slip in unnoticed. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2055;IL2057;IL2060;IL2062;IL2067;IL2070;IL2071;IL2072;IL2075;IL2087;IL2090;IL2091;IL2092;IL2095;IL3050;IL3051;IL3052</WarningsAsErrors>

    <!-- NuGet Package Metadata -->
    <PackageId>Skywithin.VnumEnumeration</PackageId>
    <!-- Local/dev default only. CI sets the real version from the git tag (v* / rc-v*) via -p:Version. -->
    <Version>10.1.0</Version>
    <Authors>Max Vagner</Authors>
    <Description>A strongly-typed smart enumeration base class with value-code pairs, reflection-based discovery, and JSON serialization support</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>enumeration;smart-enum;value-object;domain-driven-design</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/skywithin/VnumEnumeration</RepositoryUrl>
    <PackageProjectUrl>https://github.com/skywithin/VnumEnumeration</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
